{
  "redirects": [
    {
      "source": "/Finance-App",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Finance-App/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "0 5 * * *"
    }
  ]
}
